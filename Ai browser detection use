let timeframe = 1h;

let NetworkAI =
DeviceNetworkEvents
| where TimeGenerated > ago(timeframe)
| where InitiatingProcessFileName in~ ("chrome.exe", "msedge.exe")
| where RemoteUrl has_any (
    "openai.com","anthropic.com","x.ai","deepseek",
    "generativelanguage.googleapis.com","grammarly.com","copilot.microsoft.com"
)
| summarize NetCount = count() by DeviceName, InitiatingProcessAccountName;

let ExtensionsAI =
DeviceFileEvents
| where TimeGenerated > ago(timeframe)
| where FolderPath has "Extensions"
| where FileName has_any ("gemini","copilot","grammarly","openai","gpt","ai")
| summarize ExtCount = count() by DeviceName, InitiatingProcessAccountName;

NetworkAI
| join kind=leftouter ExtensionsAI on DeviceName, InitiatingProcessAccountName
| extend ExtCount = coalesce(ExtCount, 0)
| extend RiskScore = NetCount * 2 + ExtCount
| where RiskScore > 10
| project DeviceName, InitiatingProcessAccountName, NetCount, ExtCount, RiskScore
| sort by RiskScore desc



This detection identifies potential unauthorized use of artificial intelligence (AI) services through web browsers by correlating outbound network connections with local browser extension-related activity.
The rule monitors browser-initiated network traffic (e.g., Google Chrome, Microsoft Edge) to known AI service providers such as OpenAI, Anthropic, DeepSeek, Google Gemini APIs, Microsoft Copilot, and Grammarly. It then correlates this activity with file system events associated with browser extensions to increase detection confidence.
A risk score is calculated based on the volume of network connections and extension-related activity. Alerts are generated when this score exceeds a defined threshold, indicating a higher likelihood of unauthorized AI usage.
This detection is particularly useful in environments where:
AI tools are restricted or not officially approved
Data exfiltration via AI platforms is a concern
Browser-based AI usage is not centrally controlled



(
index=sysmon EventCode=22
(
    QueryName="*openai.com*"
    OR QueryName="*anthropic.com*"
    OR QueryName="*claude.ai*"
    OR QueryName="*x.ai*"
    OR QueryName="*deepseek*"
    OR QueryName="*generativelanguage.googleapis.com*"
    OR QueryName="*copilot.microsoft.com*"
    OR QueryName="*grammarly.com*"
)
)
| eval isDNS=1
| append
[
    search index=sysmon EventCode=1
    (Image="*\\chrome.exe" OR Image="*\\msedge.exe")
    (CommandLine="*copilot*" OR CommandLine="*gemini*" OR CommandLine="*ai*")
    | eval isProc=1
]
| stats 
    count(eval(isDNS=1)) as DNSCount
    count(eval(isProc=1)) as ProcCount
    by Computer, User
| eval RiskScore = DNSCount*2 + ProcCount
| where RiskScore > 10
| sort -RiskScore
