let timeframe = 30d;
DeviceFileEvents
| where TimeGenerated > ago(timeframe)
| where FolderPath has @"\Extensions\"
| where FolderPath has_any (
    @"\Google\Chrome\User Data\",
    @"\Microsoft\Edge\User Data\",
    @"\BraveSoftware\Brave-Browser\User Data\"
)
| extend Browser = case(
    FolderPath has @"\Google\Chrome\User Data\", "Google Chrome",
    FolderPath has @"\Microsoft\Edge\User Data\", "Microsoft Edge",
    FolderPath has @"\BraveSoftware\Brave-Browser\User Data\", "Brave",
    "Unknown"
)
| extend ExtensionId = extract(@"\\Extensions\\([a-z]{32})\\", 1, FolderPath)
| extend ExtensionVersion = extract(@"\\Extensions\\[a-z]{32}\\([^\\]+)\\", 1, FolderPath)
| extend BrowserProfile = extract(@"\\User Data\\([^\\]+)\\Extensions\\", 1, FolderPath)
| where isnotempty(ExtensionId)
| summarize
    FirstSeen=min(TimeGenerated),
    LastSeen=max(TimeGenerated),
    FileEvents=count(),
    ExamplePath=any(FolderPath),
    Devices=make_set(DeviceName),
    Accounts=make_set(InitiatingProcessAccountName),
    Versions=make_set(ExtensionVersion),
    Profiles=make_set(BrowserProfile)
    by Browser, ExtensionId
| sort by LastSeen desc
